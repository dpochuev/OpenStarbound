{
  // Space Combat Configuration
  // This is a prototype feature - disabled by default
  
  "arenaWidth" : 2000.0,
  "arenaHeight" : 2000.0,
  
  // Default ship physics (can be overridden by ship structure calculations)
  "defaultShipMass" : 100.0,
  "defaultThrust" : 500.0,
  "defaultTurnRate" : 2.0,
  "shipDrag" : 0.1,
  
  // Projectile defaults
  "projectileSpeed" : 300.0,
  "projectileDamage" : 10.0,
  
  // Network tick rate (updates per second)
  "tickRate" : 20.0,
  
  // Ship rendering scale in combat view
  "shipRenderScale" : 0.5,
  
  // Combat HUD settings
  "hud" : {
    "showHealthBar" : true,
    "showMinimap" : true,
    "minimapSize" : 150
  }
}
